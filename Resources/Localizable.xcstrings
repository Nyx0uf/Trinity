{
  "sourceLanguage" : "en",
  "strings" : {
    "aboutApplicationName" : {
      "comment" : "Application name shown in the About panel.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinity"
          }
        }
      }
    },
    "aboutCredits" : {
      "comment" : "Credits shown in the About panel.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A native Metal port of Rezmason’s classic Matrix rain.\nOriginal effect © 2018 Rezmason · MIT License"
          }
        }
      }
    },
    "diagnosticsSummary" : {
      "comment" : "Performance overlay. Formatted numbers: %1$@ requested fps, %2$@ measured fps, %3$@ × %4$@ render width and height in pixels, %5$@ GPU time per frame, %6$@ skipped frames.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target %1$@ fps · Actual %2$@ fps · %3$@ × %4$@ · GPU %5$@ ms · Skipped %6$@"
          }
        }
      }
    },
    "errorGlyphAtlasMissing" : {
      "comment" : "Rendering error: the glyph image resource is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The classic glyph atlas is missing."
          }
        }
      }
    },
    "errorMetalUnavailable" : {
      "comment" : "Rendering error: no Metal device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metal is unavailable on this Mac."
